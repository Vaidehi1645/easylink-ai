# Copy this file to .env and fill in your keys.
# NEVER commit .env to git (it is already in .gitignore).

# Provider: "openai", "gemini", or "mock" (offline, free, for testing the pipeline)
# If EASYLINK_PROVIDER is blank, we auto-detect from whichever key you set below.
EASYLINK_PROVIDER=

# Your OpenAI API key (starts with sk-) — keep secret, never share or commit
OPENAI_API_KEY=

# Your Google Gemini API key (starts with AIza...) — keep secret
GEMINI_API_KEY=

# Models (leave blank to use provider defaults):
#   openai : gpt-4o-mini / text-embedding-3-small
#   gemini : gemini-3.8-flash / gemini-embedding-001
EASYLINK_CHAT_MODEL=
EASYLINK_EMBED_MODEL=

# Tunables (safe defaults; override only when tuning quality)
# Minimum cosine similarity for a retrieved chunk to count as "known".
# OpenAI default: 0.30   Mock default: 0.12
# EASYLINK_MIN_SIMILARITY=0.30

# --- Owner sign-in (Google + GitHub OAuth; all four blank = login OFF) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
#   Authorized redirect URI: http://127.0.0.1:8000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New (callback URL):
#   http://127.0.0.1:8000/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional:
#   EASYLINK_PUBLIC_URL=https://your-domain   production URL behind a proxy (Google requires HTTPS)
#   EASYLINK_SESSION_DAYS=30                  session lifetime in days
#   EASYLINK_DEMO_GATE=false                  let visitors open demos without signing in
