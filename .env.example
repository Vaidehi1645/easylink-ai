# Copy this file to .env and fill in your keys.
# NEVER commit .env to git (it is already in .gitignore).

# Provider: "openai", "gemini", or "mock" (offline, free, for testing the pipeline)
# If EASYLINK_PROVIDER is blank, we auto-detect from whichever key you set below.
EASYLINK_PROVIDER=

# Your OpenAI API key (starts with sk-) — keep secret, never share or commit
OPENAI_API_KEY=

# Your Google Gemini API key (starts with AIza...) — keep secret
GEMINI_API_KEY=

# Models (leave blank to use provider defaults):
#   openai : gpt-4o-mini / text-embedding-3-small
#   gemini : gemini-3.8-flash / gemini-embedding-001
EASYLINK_CHAT_MODEL=
EASYLINK_EMBED_MODEL=

# Tunables (safe defaults; override only when tuning quality)
# Minimum cosine similarity for a retrieved chunk to count as "known".
# OpenAI default: 0.30   Mock default: 0.12
# EASYLINK_MIN_SIMILARITY=0.30
